---
/**
 * Dashboard chrome for /app/* (on-demand only). The handle comes from the
 * cosmetic state cookie parsed by the middleware; it is display-only.
 *
 * Layout: sidebar from `md`, a top bar with a <details> menu below it.
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title: string;
	/** one-line help shown under the page title */
	intro?: string;
	/** docs page for this screen, e.g. "dashboard/personas" */
	docs?: string;
}

const { title, intro, docs } = Astro.props;
const session = Astro.locals.session ?? null;
const handle = session?.handle ?? 'anonymous';
const initials = handle.slice(0, 2).toUpperCase();
---

<Base title={title}>
	<div class="flex min-h-screen flex-col md:flex-row">
		<!-- mobile top bar -->
		<header class="flex items-center justify-between gap-3 border-b border-line bg-surface px-4 py-2.5 md:hidden">
			<a href="/" class="flex items-center gap-2 text-base font-semibold tracking-tight">
				<span class="grid size-7 place-items-center rounded-lg bg-brand-600 text-xs font-bold text-white">A</span>
				Afixo
			</a>
			<div class="flex items-center gap-1">
				<ThemeToggle />
				<details class="relative">
					<summary class="btn btn-ghost btn-icon list-none" aria-label="Open menu">
						<Icon name="menu" class="size-5" />
					</summary>
					<div class="absolute right-0 z-30 mt-2 w-60 rounded-card border border-line bg-surface p-2 shadow-pop">
						<Nav current={Astro.url.pathname} />
						<div class="mt-2 border-t border-line pt-2">
							<button type="button" class="nav-link w-full" data-logout>
								<Icon name="logout" class="size-[1.125rem] opacity-80" /> Sign out
							</button>
						</div>
					</div>
				</details>
			</div>
		</header>

		<!-- sidebar -->
		<aside class="hidden w-60 shrink-0 flex-col gap-6 border-r border-line bg-surface p-4 md:sticky md:top-0 md:flex md:h-screen">
			<a href="/" class="flex items-center gap-2.5 px-1 text-lg font-semibold tracking-tight">
				<span class="grid size-8 place-items-center rounded-lg bg-brand-600 text-sm font-bold text-white shadow-sm">A</span>
				Afixo
			</a>
			<Nav current={Astro.url.pathname} />
			<div class="mt-auto flex flex-col gap-3 border-t border-line pt-4">
				<div class="flex items-center gap-2.5 px-1">
					<span
						class="grid size-8 shrink-0 place-items-center rounded-full bg-brand-100 text-xs font-semibold text-brand-800 dark:bg-brand-900 dark:text-brand-200"
						aria-hidden="true">{initials}</span
					>
					<div class="min-w-0 text-sm">
						<p class="truncate font-medium" title={handle}>@{handle}</p>
						<p class="text-xs text-ink-3">signed in with GitHub</p>
					</div>
				</div>
				<div class="flex items-center justify-between gap-2">
					<button type="button" class="btn btn-ghost btn-sm" data-logout>
						<Icon name="logout" class="size-4" /> Sign out
					</button>
					<ThemeToggle />
				</div>
			</div>
		</aside>

		<main id="main" class="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
			<div class="mx-auto max-w-6xl">
				<header class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
					<div class="max-w-3xl">
						<h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
						{intro && <p class="mt-1.5 text-sm text-ink-2">{intro}</p>}
					</div>
					{
						docs && (
							<a href={`https://docs.afixo.io/${docs}/`} class="btn btn-ghost btn-sm shrink-0" target="_blank" rel="noopener">
								Guide <Icon name="external" class="size-3.5" />
							</a>
						)
					}
				</header>
				<slot />
			</div>
		</main>
	</div>
</Base>

<script>
	import { api } from '../lib/api';

	for (const b of document.querySelectorAll<HTMLButtonElement>('[data-logout]')) {
		b.addEventListener('click', async () => {
			b.disabled = true;
			try {
				await api.auth.logout();
			} catch {
				// Cookies may already be gone; either way the dashboard is no longer usable.
			}
			window.location.assign('/');
		});
	}
</script>
