---
interface Props {
	/** current pathname, for aria-current */
	current: string;
}

const { current } = Astro.props;

const items = [
	{ href: '/app', label: 'Overview' },
	{ href: '/app/personas', label: 'Personas' },
	{ href: '/app/clients', label: 'API clients' },
	{ href: '/app/policies', label: 'Policies' },
	{ href: '/app/explorer', label: 'Explorer' },
	{ href: '/app/audit', label: 'Audit' },
];
---

<nav aria-label="Dashboard">
	<ul class="flex flex-col gap-0.5 text-sm">
		{
			items.map((item) => {
				const active = current === item.href;
				return (
					<li>
						<a
							href={item.href}
							aria-current={active ? 'page' : undefined}
							class:list={[
								'block rounded-md px-2 py-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-800',
								active && 'bg-zinc-100 font-medium dark:bg-zinc-800',
							]}
						>
							{item.label}
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>
