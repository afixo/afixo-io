---
import Icon, { type IconName } from './Icon.astro';

interface Props {
	/** current pathname, for aria-current */
	current: string;
	class?: string;
}

const { current, class: className } = Astro.props;

const items: { href: string; label: string; icon: IconName }[] = [
	{ href: '/app', label: 'Overview', icon: 'home' },
	{ href: '/app/personas', label: 'Personas', icon: 'persona' },
	{ href: '/app/clients', label: 'API clients', icon: 'key' },
	{ href: '/app/policies', label: 'Policies', icon: 'shield' },
	{ href: '/app/explorer', label: 'Explorer', icon: 'compass' },
	{ href: '/app/audit', label: 'Audit', icon: 'list' },
];
---

<nav aria-label="Dashboard" class={className}>
	<ul class="flex flex-col gap-0.5">
		{
			items.map((item) => {
				const active = current === item.href;
				return (
					<li>
						<a href={item.href} aria-current={active ? 'page' : undefined} class="nav-link">
							<Icon name={item.icon} class="size-[1.125rem] opacity-80" />
							{item.label}
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>
