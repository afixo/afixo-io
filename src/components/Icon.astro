const { name, class: className, label, ...rest } = Astro.props;
const d = paths[name];
---

<svg
	class:list={['inline-block size-[1.1em] shrink-0', className]}
	viewBox="0 0 24 24"
	fill={name === 'github' ? 'currentColor' : 'none'}
	stroke={name === 'github' ? 'none' : 'currentColor'}
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : 'true'}
	role={label ? 'img' : undefined}
	aria-label={label}
	focusable="false"
	{...rest}
>
	<path d={d}></path>
</svg>
