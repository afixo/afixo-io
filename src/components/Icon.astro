---
/**
 * Inline stroke icons (24×24 viewBox, currentColor). Decorative by default —
 * pass `label` to make one meaningful (it becomes the accessible name).
 */
interface Props {
	name: IconName;
	class?: string;
	label?: string;
	[key: `data-${string}`]: string | undefined;
}

export type IconName =
	| 'home'
	| 'persona'
	| 'key'
	| 'shield'
	| 'compass'
	| 'list'
	| 'sun'
	| 'moon'
	| 'monitor'
	| 'github'
	| 'check'
	| 'arrow'
	| 'info'
	| 'warning'
	| 'sparkle'
	| 'lock'
	| 'eye'
	| 'eye-off'
	| 'copy'
	| 'menu'
	| 'close'
	| 'logout'
	| 'external';

const paths: Record<IconName, string> = {
