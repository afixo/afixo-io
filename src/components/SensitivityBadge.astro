---
import { SENSITIVITY_LABEL, type Sensitivity } from '../lib/api';
import { SENSITIVITY_CLASS } from '../lib/ui';

interface Props {
	level: Sensitivity;
}

const { level } = Astro.props;
---

<span class:list={['badge', SENSITIVITY_CLASS[level]]} title={`sensitivity ${level}`}>
	{level} · {SENSITIVITY_LABEL[level]}
</span>
