---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

const features = [
	{
		title: 'Context-specific personas',
		body: 'A subject keeps several partial identities — social, work, legal — each a bundle of typed fields graded 0–3 by sensitivity.',
	},
	{
		title: 'Purpose-aware disclosure',
		body: 'Requesters declare a purpose with every call. Grant-only rules keyed on (requester, purpose) decide which persona and which fields come back. Deny by default.',
	},
	{
		title: 'Audited by construction',
		body: 'Every allow and deny is written to a hash-chained log the subject can read and verify: who asked, why, and exactly which keys were released.',
	},
];

const sample = `GET https://api.afixo.io/v1/disclose/alice?purpose=shipping
Authorization: Bearer <requester token>

HTTP/1.1 200 OK
{
  "decision": "allow",
  "persona": "shipping",
  "fields": { "name": "Alice Example", "postal_address": "1 Example Row, Leeds" },
  "withheld": ["dob"],
  "decision_id": "dec_01j9…"
}`;
---

<Base title="Developer identity infrastructure">
	<SiteHeader />
	<main class="mx-auto max-w-5xl px-6 py-16">
		<section class="max-w-3xl">
			<p class="text-sm font-medium text-brand-600 dark:text-brand-500">Afixo</p>
			<h1 class="mt-2 text-4xl font-semibold tracking-tight">Developer identity infrastructure</h1>
			<p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
				Context-specific personas, purpose-aware disclosure at the API boundary. One endpoint returns exactly the
				identity a caller is permitted to see — for that caller, for that reason — and nothing else.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/login" class="btn btn-primary">Sign in with GitHub</a>
				<a href="https://docs.afixo.io/" class="btn">Read the API reference</a>
			</div>
		</section>

		<section class="mt-16 grid gap-6 md:grid-cols-3">
			{
				features.map((f) => (
					<article class="card">
						<h2 class="font-semibold">{f.title}</h2>
						<p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{f.body}</p>
					</article>
				))
			}
		</section>

		<section class="mt-16">
			<h2 class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">The product endpoint</h2>
			<pre
				class="mt-3 overflow-x-auto rounded-lg border border-zinc-200 bg-zinc-50 p-4 font-mono text-sm leading-relaxed dark:border-zinc-800 dark:bg-zinc-900"><code>{sample}</code></pre>
			<p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
				Same subject, different purpose or different requester → a different persona, a different field set, or a
				uniform <code class="font-mono">403</code>. Unknown subjects are indistinguishable from denied ones.
			</p>
		</section>
	</main>
	<footer class="mx-auto max-w-5xl px-6 py-10 text-xs text-zinc-500">
		<a href="https://docs.afixo.io/" class="hover:underline">API reference</a> · <a href="/login" class="hover:underline">Sign in</a>
	</footer>
</Base>
