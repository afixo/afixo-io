---
/**
 * Prerendered. The sign-in link is a plain anchor (not a form) on purpose:
 * afixo-api answers it with a redirect to GitHub, and `form-action 'self'` in
 * the CSP would block that redirect for a form post. `?error=<code>` comes
 * from afixo-api when the callback fails.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Sign in">
	<SiteHeader />
	<main id="main" class="hero-bg flex min-h-[calc(100vh-3.5rem)] items-start justify-center px-4 py-16 sm:px-6">
		<div class="card w-full max-w-md p-8">
			<span class="grid size-10 place-items-center rounded-xl bg-brand-600 text-base font-bold text-white shadow-sm">A</span>
			<h1 class="mt-5 text-2xl font-semibold tracking-tight">Sign in to Afixo</h1>
			<p class="mt-2 text-sm text-ink-2">
				Use your GitHub account. We only read your public profile (<code class="font-mono text-xs">read:user</code>) to
				create your handle — nothing else, ever.
			</p>
			<div id="login-error" hidden class="callout callout-danger mt-5" role="alert">
				<Icon name="warning" class="mt-0.5 size-4 text-danger" />
				<p id="login-error-text"></p>
			</div>
			<a href="/api/v1/auth/github/login" class="btn btn-primary mt-6 w-full">
				<Icon name="github" class="size-4" /> Continue with GitHub
			</a>
			<p id="already" hidden class="mt-4 text-sm text-ink-2">
				You appear to be signed in already — <a href="/app" class="link">open the dashboard</a>.
			</p>
			<p class="mt-6 text-xs text-ink-3">
				By signing in you get a personal space for personas, API clients and disclosure rules. Nothing is shared until you
				write a rule.
			</p>
		</div>
	</main>
</Base>

<script>
	import { stateFromDocument } from '../lib/session';

	const MESSAGES: Record<string, string> = {
		access_denied: 'GitHub sign-in was cancelled.',
		login_failed: 'GitHub sign-in could not be completed. Please try again.',
		invalid_state: 'The sign-in request expired or did not match. Please try again.',
		state_mismatch: 'The sign-in request expired or did not match. Please try again.',
		oauth_failed: 'GitHub could not complete the sign-in. Please try again.',
		session_expired: 'Your session expired. Please sign in again.',
	};

	const code = new URLSearchParams(window.location.search).get('error');
	if (code) {
		document.getElementById('login-error-text')!.textContent = MESSAGES[code] ?? `Sign-in failed (${code}).`;
		document.getElementById('login-error')!.hidden = false;
	}
	if (stateFromDocument()) document.getElementById('already')!.hidden = false;
</script>
