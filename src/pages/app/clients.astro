---
export const prerender = false;

import App from '../../layouts/App.astro';
import Card from '../../components/Card.astro';
import Callout from '../../components/Callout.astro';
import Field from '../../components/Field.astro';
---

<App
	title="API clients"
	intro="A client is an application that asks for your data — a shop's checkout, an applicant-tracking system, your own script. Each gets its own credentials and its own rules."
	docs="dashboard/api-clients"
>
	<Callout kind="info" title="Secrets are shown once">
		The server stores only a hash of each client secret. When you register or rotate a client, copy the secret into your
		own secret manager; this browser also keeps it (<code class="font-mono text-xs">localStorage</code>) so the Explorer can act
		as that client.
	</Callout>

	<Card title="Register a client" icon="key" class="mt-6">
		<form id="register" class="flex flex-wrap items-end gap-3">
			<Field
				for="client-name"
				label="Name"
				tip="A label you will recognise in rules and in the audit log — the integrating app, not a person."
			>
				<input id="client-name" name="name" required maxlength="80" placeholder="ShopCo Checkout" class="input w-64" autocomplete="off" />
			</Field>
			<button class="btn btn-primary">Register</button>
			<span id="register-status" class="text-sm"></span>
		</form>
	</Card>

	<section id="secret" hidden class="mt-6"></section>

	<Card title="Registered clients" icon="list" class="mt-6">
		<div id="clients"></div>
	</Card>
</App>

<script>
	import { api, type Requester } from '../../lib/api';
	import { confirmDialog } from '../../lib/dialog';
	import { forgetStoredClient, loadStoredClients, saveStoredClient, type StoredClient } from '../../lib/machine';
	import { copyButton, emptyState, errorMessage, fmtTime, formValues, h, must, skeleton, status, td, tip } from '../../lib/ui';

	const list = must<HTMLElement>('#clients');
	const form = must<HTMLFormElement>('#register');
	const formStatus = must<HTMLElement>('#register-status');
	const secretPanel = must<HTMLElement>('#secret');
	list.replaceChildren(skeleton(3));

	function showSecret(client: StoredClient, what: 'registered' | 'rotated'): void {
		secretPanel.replaceChildren(
			h(
				'div',
				{ class: 'callout callout-warn', role: 'status' },
				h('div', { class: 'min-w-0 flex-1' },
					h('p', { class: 'font-semibold' }, what === 'registered' ? `“${client.name}” is registered — save its secret now` : `New secret for “${client.name}”`),
					h('p', { class: 'mt-1 text-sm text-ink-2' }, 'This is the only time the secret is shown. It has also been saved in this browser for the Explorer.'),
					h(
						'dl',
						{ class: 'mt-3 grid gap-3 text-sm sm:grid-cols-[auto_1fr] sm:items-center' },
						h('dt', { class: 'text-ink-2' }, 'client_id'),
						h('dd', { class: 'flex flex-wrap items-center gap-2' }, h('code', { class: 'rounded bg-surface px-1.5 py-0.5 font-mono text-xs break-all' }, client.client_id), copyButton(client.client_id, 'Copy id')),
						h('dt', { class: 'text-ink-2' }, 'client_secret'),
						h('dd', { class: 'flex flex-wrap items-center gap-2' }, h('code', { class: 'rounded bg-surface px-1.5 py-0.5 font-mono text-xs break-all' }, client.client_secret), copyButton(client.client_secret, 'Copy secret')),
					),
				),
			),
		);
		secretPanel.hidden = false;
		secretPanel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
	}

	function row(r: Requester, stored: StoredClient | undefined, note: HTMLElement): HTMLTableRowElement {
		const rotate = h(
			'button',
			{
				type: 'button',
				class: 'btn btn-sm',
				onclick: async () => {
					const ok = await confirmDialog({
						title: `Rotate the secret for “${r.name}”?`,
						body: 'The current secret and any tokens issued with it stop working immediately. The client id stays the same.',
						confirmLabel: 'Rotate secret',
						danger: true,
					});
					if (!ok) return;
					try {
						const res = await api.requesters.rotateSecret(r.id);
						const client: StoredClient = {
							id: r.id,
							name: r.name,
							client_id: res.client_id ?? r.client_id,
							client_secret: res.client_secret,
							saved_at: new Date().toISOString(),
						};
						saveStoredClient(client);
						showSecret(client, 'rotated');
						await load();
					} catch (e) {
						status(note, errorMessage(e), 'error');
					}
				},
			},
			'Rotate secret',
		);
		const forget = stored
			? h(
					'button',
					{
						type: 'button',
						class: 'btn btn-sm btn-ghost',
						onclick: () => {
							forgetStoredClient(r.id);
							void load();
						},
					},
					'Forget local secret',
				)
			: null;
		return h(
			'tr',
			{},
			td(h('span', { class: 'font-medium' }, r.name)),
			td(h('code', { class: 'font-mono text-xs break-all' }, r.client_id)),
			td(h('span', { class: 'whitespace-nowrap text-ink-2' }, fmtTime(r.created_at))),
			td(
				stored
					? h('span', { class: 'pill pill-ok', title: `saved ${fmtTime(stored.saved_at)}` }, 'secret in this browser')
					: h('span', { class: 'pill pill-muted' }, 'no local secret'),
			),
			h('td', { class: 'text-right whitespace-nowrap' }, rotate, forget ? ' ' : null, forget),
		);
	}

	async function load(): Promise<void> {
		try {
			const requesters = await api.requesters.list();
			const stored = loadStoredClients();
			if (!requesters.length) {
				list.replaceChildren(emptyState('No clients yet. Register one above to get a client id and secret.'));
				return;
			}
			const note = h('p', { class: 'mt-2 text-sm' });
			list.replaceChildren(
				h(
					'div',
					{ class: 'overflow-x-auto' },
					h(
						'table',
						{ class: 'table' },
						h(
							'thead',
							{},
							h(
								'tr',
								{},
								h('th', { scope: 'col' }, 'Name'),
								h('th', { scope: 'col' }, 'client_id'),
								h('th', { scope: 'col' }, 'Created'),
								h('th', { scope: 'col' }, h('span', { class: 'inline-flex items-center gap-1' }, 'Secret', tip('the secret column', 'Whether this browser still holds the plaintext secret. Rotate to get a new one if it was lost.'))),
								h('th', { scope: 'col' }, h('span', { class: 'sr-only' }, 'Actions')),
							),
						),
						h('tbody', {}, ...requesters.map((r) => row(r, stored.find((s) => s.id === r.id || s.client_id === r.client_id), note))),
					),
				),
				note,
			);
		} catch (e) {
			list.replaceChildren(h('p', { class: 'text-sm text-danger' }, `Could not load clients: ${errorMessage(e)}`));
		}
	}

	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const { name } = formValues(form);
		try {
			status(formStatus, 'Registering…');
			const reg = await api.requesters.create({ name: (name ?? '').trim() });
			const client: StoredClient = {
				id: reg.id,
				name: reg.name,
				client_id: reg.client_id,
				client_secret: reg.client_secret,
				saved_at: new Date().toISOString(),
			};
			saveStoredClient(client);
			showSecret(client, 'registered');
			form.reset();
			status(formStatus, 'Registered.', 'ok');
			await load();
		} catch (e) {
			status(formStatus, errorMessage(e), 'error');
		}
	});

	load();
</script>
