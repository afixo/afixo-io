---
export const prerender = false;

import App from '../../layouts/App.astro';
import Card from '../../components/Card.astro';
import Callout from '../../components/Callout.astro';
import Field from '../../components/Field.astro';
import { PURPOSES, SENSITIVITIES, SENSITIVITY_LABEL } from '../../lib/api';
---

<App
	title="Policies"
	intro="Rules decide what a client sees. Each rule grants one persona to a (client, purpose) pair, capped by a sensitivity ceiling and, optionally, an allow-list."
	docs="dashboard/policies"
>
	<Callout kind="info" title="How a request is decided">
		<ol class="mt-1 list-decimal space-y-0.5 pl-4">
			<li>Collect the rules that match the caller and the purpose — wildcards (“any”) count.</li>
			<li>
				The most <em>specific</em> rule wins: client + purpose beats client only, beats purpose only, beats “any / any”.
				Ties go to the higher priority, then the newest rule.
			</li>
			<li>Release the persona's fields within the ceiling and on the allow-list. No rule → deny. Rules never restrict other rules.</li>
		</ol>
	</Callout>

	<Card title="New rule" icon="shield" class="mt-6">
		<form id="rule-form" class="grid gap-x-4 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
			<Field for="f-requester" label="Client" tip="Which application this rule answers. “Any client” makes it a fallback for callers no other rule covers.">
				<select id="f-requester" name="requester_id" class="input w-full">
					<option value="">any client</option>
				</select>
			</Field>

			<Field for="f-purpose" label="Purpose" tip="The reason the caller states when it asks. A rule for “shipping” never answers a “billing” request.">
				<select id="f-purpose" name="purpose" class="input w-full">
					<option value="">any purpose</option>
					{PURPOSES.map((p) => <option value={p}>{p}</option>)}
				</select>
			</Field>

			<Field for="f-persona" label="Persona to disclose" tip="The bundle of fields this rule draws from. Only fields in this persona can ever be released by it.">
				<select id="f-persona" name="persona_id" required class="input w-full"></select>
			</Field>

			<Field
				for="f-sensitivity"
				label="Max sensitivity (ceiling)"
				tip="Fields graded above this tier are withheld, even when the allow-list names them. Start low and raise it deliberately."
			>
				<select id="f-sensitivity" name="max_sensitivity" class="input w-full">
					{SENSITIVITIES.map((s) => <option value={s} selected={s === 1}>{s} · {SENSITIVITY_LABEL[s]}</option>)}
				</select>
			</Field>

			<Field
				for="f-allow"
				label="Allow keys"
				tip="Optional. Comma-separated field keys; leave blank to release every field under the ceiling."
				hint="Leave blank for every field under the ceiling."
			>
				<input id="f-allow" name="allow_keys" placeholder="name, email" class="input w-full" autocomplete="off" />
			</Field>

			<Field
				for="f-priority"
				label="Priority"
				tip="Only breaks ties between rules of equal specificity. Higher wins; the newest rule wins if the priorities also match."
				tipRight
				hint="Tie-breaker between equally specific rules."
			>
				<input id="f-priority" name="priority" type="number" value="0" step="1" inputmode="numeric" class="input w-full" />
			</Field>

			<div class="flex flex-wrap items-center gap-3 sm:col-span-2 lg:col-span-3">
				<button class="btn btn-primary">Create rule</button>
				<span id="rule-status" class="text-sm"></span>
			</div>
		</form>

		<Callout kind="warn" id="catch-all" title="This is a catch-all" class="mt-4" hidden>
			With no client and no purpose it applies to every caller and every purpose that no more specific rule covers.
		</Callout>

		<div class="mt-5 border-t border-line pt-4">
			<h3 class="card-kicker mb-2 flex items-center gap-1.5">
				Live preview
			</h3>
			<div id="preview" class="grid gap-4 sm:grid-cols-2"></div>
		</div>
	</Card>

	<Card title="Rules in force" icon="list" class="mt-6">
		<div id="rules"></div>
	</Card>
</App>

<script>
	import {
		api,
		isPurpose,
		parseAllowKeys,
		previewDisclosure,
		specificity,
		toSensitivity,
		type Field,
		type NewRule,
		type Persona,
		type Requester,
		type Rule,
	} from '../../lib/api';
	import { confirmDialog } from '../../lib/dialog';
	import { badge, emptyState, errorMessage, h, must, skeleton, status, td, tip } from '../../lib/ui';

	const form = must<HTMLFormElement>('#rule-form');
	const formStatus = must<HTMLElement>('#rule-status');
	const preview = must<HTMLElement>('#preview');
	const catchAll = must<HTMLElement>('#catch-all');
	const rulesBox = must<HTMLElement>('#rules');
	const requesterSel = must<HTMLSelectElement>('#f-requester');
	const purposeSel = must<HTMLSelectElement>('#f-purpose');
	const personaSel = must<HTMLSelectElement>('#f-persona');
	const sensSel = must<HTMLSelectElement>('#f-sensitivity');
	const allowInput = must<HTMLInputElement>('#f-allow');
	const priorityInput = must<HTMLInputElement>('#f-priority');

	let personas: Persona[] = [];
	let requesters: Requester[] = [];

	rulesBox.replaceChildren(skeleton(4));

	function fillSelect(
		sel: HTMLSelectElement,
		options: { value: string; label: string }[],
		first?: { value: string; label: string },
	): void {
		const previous = sel.value;
		const all = first ? [first, ...options] : options;
		sel.replaceChildren(...all.map((o) => h('option', { value: o.value }, o.label)));
		if (all.some((o) => o.value === previous)) sel.value = previous;
	}

	function fieldList(title: string, fields: Field[], tone: string): HTMLElement {
		return h(
			'div',
			{},
			h(
				'h4',
				{ class: `mb-1.5 text-xs font-semibold tracking-wider uppercase ${tone}` },
				`${title} · ${fields.length}`,
			),
			fields.length
				? h(
						'ul',
						{ class: 'flex flex-col gap-1' },
						...fields.map((f) =>
							h(
								'li',
								{ class: 'flex flex-wrap items-center gap-2 text-sm' },
								h('code', { class: 'font-mono text-xs' }, f.key),
								badge(f.sensitivity),
							),
						),
					)
				: h('p', { class: 'text-sm text-ink-3' }, 'nothing'),
		);
	}

	function renderPreview(): void {
		catchAll.hidden = !(requesterSel.value === '' && purposeSel.value === '');
		const persona = personas.find((p) => p.id === personaSel.value);
		if (!persona) {
			preview.replaceChildren(
				personas.length
					? emptyState('Pick a persona to preview what this rule discloses.')
					: emptyState('Create a persona first — a rule must name one.', { label: 'Go to Personas', href: '/app/personas' }),
			);
			return;
		}
		const { disclosed, withheld } = previewDisclosure(
			persona.fields,
			toSensitivity(sensSel.value),
			parseAllowKeys(allowInput.value),
		);
		preview.replaceChildren(fieldList('Disclosed', disclosed, 'text-ok'), fieldList('Withheld', withheld, 'text-danger'));
	}

	function ruleRow(rule: Rule): HTMLTableRowElement {
		const requester = rule.requester_id
			? (requesters.find((r) => r.id === rule.requester_id)?.name ?? rule.requester_id)
			: 'any client';
		const persona = personas.find((p) => p.id === rule.persona_id);
		const disclosed = persona ? previewDisclosure(persona.fields, rule.max_sensitivity, rule.allow_keys).disclosed : [];
		const remove = h(
			'button',
			{
				type: 'button',
				class: 'btn btn-sm btn-danger',
				'aria-label': `Delete the rule for ${requester} / ${rule.purpose ?? 'any purpose'}`,
				onclick: async () => {
					const ok = await confirmDialog({
						title: 'Delete this rule?',
						body: 'Requests it currently allows will be denied unless another rule covers them.',
						confirmLabel: 'Delete rule',
						danger: true,
					});
					if (!ok) return;
					try {
						await api.rules.remove(rule.id);
						await load();
					} catch (e) {
						status(formStatus, errorMessage(e), 'error');
					}
				},
			},
			'Delete',
		);
		return h(
			'tr',
			{},
			td(h('span', { class: rule.requester_id ? 'font-medium' : 'text-ink-3' }, requester)),
			td(
				rule.purpose
					? h('code', { class: 'font-mono text-xs' }, rule.purpose)
					: h('span', { class: 'text-ink-3' }, 'any purpose'),
			),
			td(persona ? persona.name : h('span', { class: 'text-danger' }, 'missing persona')),
			td(badge(rule.max_sensitivity)),
			td(
				rule.allow_keys?.length
					? h('code', { class: 'font-mono text-xs' }, rule.allow_keys.join(', '))
					: h('span', { class: 'text-ink-3' }, 'all keys'),
			),
			td(h('span', { class: 'tabular-nums' }, String(rule.priority))),
			td(h('span', { class: 'tabular-nums' }, String(specificity(rule)))),
			td(
				disclosed.length
					? h('code', { class: 'font-mono text-xs' }, disclosed.map((f) => f.key).join(', '))
					: h('span', { class: 'text-ink-3' }, '—'),
			),
			h('td', { class: 'text-right' }, remove),
		);
	}

	function th(label: string, help?: string): HTMLTableCellElement {
		const cell = h('th', { scope: 'col' });
		cell.append(
			help
				? h('span', { class: 'inline-flex items-center gap-1' }, label, tip(`the ${label.toLowerCase()} column`, help, true))
				: label,
		);
		return cell;
	}

	function renderRules(rules: Rule[]): void {
		if (!rules.length) {
			rulesBox.replaceChildren(
				emptyState('No rules yet — every disclosure request is currently denied. Add the first rule above.'),
			);
			return;
		}
		const ordered = [...rules].sort(
			(a, b) =>
				specificity(b) - specificity(a) ||
				b.priority - a.priority ||
				(b.created_at ?? '').localeCompare(a.created_at ?? ''),
		);
		rulesBox.replaceChildren(
			h(
				'div',
				{ class: 'overflow-x-auto' },
				h(
					'table',
					{ class: 'table' },
					h('caption', { class: 'sr-only' }, 'Rules in force, most specific first'),
					h(
						'thead',
						{},
						h(
							'tr',
							{},
							th('Client'),
							th('Purpose'),
							th('Persona'),
							th('Ceiling', 'The highest sensitivity tier this rule releases. Anything above it is withheld.'),
							th('Allow keys'),
							th('Priority', 'Breaks ties between rules that are equally specific. Higher wins.'),
							th('Specificity', 'Client + purpose = 3, client only = 2, purpose only = 1, any/any = 0. Highest wins.'),
							th('Would disclose', 'The fields this rule releases today, given the persona it names.'),
							h('th', { scope: 'col' }, h('span', { class: 'sr-only' }, 'Actions')),
						),
					),
					h('tbody', {}, ...ordered.map(ruleRow)),
				),
			),
		);
	}

	async function load(): Promise<void> {
		try {
			const [p, r, rules] = await Promise.all([api.personas.list(), api.requesters.list(), api.rules.list()]);
			personas = p;
			requesters = r;
			fillSelect(
				requesterSel,
				requesters.map((x) => ({ value: x.id, label: x.name })),
				{ value: '', label: 'any client' },
			);
			fillSelect(
				personaSel,
				personas.map((x) => ({ value: x.id, label: x.name })),
			);
			renderPreview();
			renderRules(rules);
		} catch (e) {
			rulesBox.replaceChildren(h('p', { class: 'text-sm text-danger' }, `Could not load policies: ${errorMessage(e)}`));
		}
	}

	form.addEventListener('input', renderPreview);
	form.addEventListener('change', renderPreview);
	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		if (!personaSel.value) {
			status(formStatus, 'A rule must name a persona.', 'error');
			return;
		}
		const rule: NewRule = {
			requester_id: requesterSel.value || null,
			purpose: isPurpose(purposeSel.value) ? purposeSel.value : null,
			persona_id: personaSel.value,
			max_sensitivity: toSensitivity(sensSel.value),
			allow_keys: parseAllowKeys(allowInput.value),
			priority: Number.parseInt(priorityInput.value, 10) || 0,
		};
		try {
			status(formStatus, 'Creating…');
			await api.rules.create(rule);
			status(formStatus, 'Rule created.', 'ok');
			allowInput.value = '';
			await load();
		} catch (e) {
			status(formStatus, errorMessage(e), 'error');
		}
	});

	load();
</script>
