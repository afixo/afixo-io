---
export const prerender = false;

import App from '../../layouts/App.astro';
import Card from '../../components/Card.astro';
import Callout from '../../components/Callout.astro';
import Field from '../../components/Field.astro';
import SensitivityBadge from '../../components/SensitivityBadge.astro';
import { SENSITIVITIES } from '../../lib/api';
---

<App
	title="Personas"
	intro="A persona is one way you present yourself — legal, work, social. Each is a named bundle of fields, and each field carries a sensitivity tier."
	docs="dashboard/personas"
>
	<Callout kind="info" title="Sensitivity tiers are the ceiling a rule can lift">
		<p class="mt-1 flex flex-wrap items-center gap-1.5">
			{SENSITIVITIES.map((s) => <SensitivityBadge level={s} />)}
		</p>
		<p class="mt-2">
			A rule with a ceiling of <strong>1 · low</strong> releases only fields graded 0 or 1. Grade generously: a field you
			mark <strong>3 · high</strong> can only ever leave through a rule that explicitly allows it.
		</p>
	</Callout>

	<Card title="New persona" icon="persona" class="mt-6">
		<form id="create-persona" class="flex flex-wrap items-end gap-3">
			<Field
				for="persona-name"
				label="Name"
				tip="A short label for the context — legal, work, social. Unique per account; rules point at it."
			>
				<input id="persona-name" name="name" required maxlength="40" placeholder="work" class="input w-56" autocomplete="off" />
			</Field>
			<button class="btn btn-primary">Create persona</button>
			<span id="create-status" class="text-sm"></span>
		</form>
	</Card>

	<div id="personas" class="mt-6 flex flex-col gap-4"></div>
</App>

<script>
	import { api, SENSITIVITIES, SENSITIVITY_LABEL, toSensitivity, type Field, type Persona } from '../../lib/api';
	import { confirmDialog } from '../../lib/dialog';
	import { badge, emptyState, errorMessage, formValues, h, must, skeleton, status, tip } from '../../lib/ui';

	const list = must<HTMLElement>('#personas');
	const createForm = must<HTMLFormElement>('#create-persona');
	const createStatus = must<HTMLElement>('#create-status');
	list.replaceChildren(skeleton(4));

	function sensitivitySelect(value: number, name = 'sensitivity'): HTMLSelectElement {
		return h(
			'select',
			{ name, class: 'input', 'aria-label': 'sensitivity' },
			...SENSITIVITIES.map((s) => h('option', { value: String(s), selected: s === value }, `${s} · ${SENSITIVITY_LABEL[s]}`)),
		);
	}

	function fieldRow(persona: Persona, field: Field, note: HTMLElement): HTMLTableRowElement {
		const value = h('input', { class: 'input w-full', value: field.value, 'aria-label': `value of ${field.key}` });
		const sens = sensitivitySelect(field.sensitivity);
		const save = h(
			'button',
			{
				type: 'button',
				class: 'btn btn-sm',
				onclick: async () => {
					try {
						status(note, `Saving ${field.key}…`);
						await api.personas.putField(persona.id, field.key, { value: value.value, sensitivity: toSensitivity(sens.value) });
						status(note, `Saved ${field.key}.`, 'ok');
						await load();
					} catch (e) {
						status(note, errorMessage(e), 'error');
					}
				},
			},
			'Save',
		);
		const remove = h(
			'button',
			{
				type: 'button',
				class: 'btn btn-sm btn-danger',
				onclick: async () => {
					const ok = await confirmDialog({
						title: `Delete field “${field.key}”?`,
						body: `It will be removed from the “${persona.name}” persona. Rules stay in place; they simply can no longer release it.`,
						confirmLabel: 'Delete field',
						danger: true,
					});
					if (!ok) return;
					try {
						await api.personas.deleteField(persona.id, field.key);
						await load();
					} catch (e) {
						status(note, errorMessage(e), 'error');
					}
				},
			},
			'Delete',
		);
		return h(
			'tr',
			{},
			h('td', { class: 'font-mono text-xs' }, field.key),
			h('td', { class: 'w-full' }, value),
			h('td', { class: 'whitespace-nowrap' }, badge(field.sensitivity), ' ', sens),
			h('td', { class: 'text-right whitespace-nowrap' }, save, ' ', remove),
		);
	}

	function personaCard(persona: Persona): HTMLElement {
		const note = h('p', { class: 'mt-2 text-sm text-ink-2' });
		const table = persona.fields.length
			? h(
					'div',
					{ class: 'overflow-x-auto' },
					h(
						'table',
						{ class: 'table' },
						h('thead', {}, h('tr', {}, h('th', { scope: 'col' }, 'Key'), h('th', { scope: 'col' }, 'Value'), h('th', { scope: 'col' }, 'Sensitivity'), h('th', { scope: 'col' }, h('span', { class: 'sr-only' }, 'Actions')))),
						h('tbody', {}, ...persona.fields.map((f) => fieldRow(persona, f, note))),
					),
				)
			: emptyState('No fields yet — add the first one below.');

		const add = h(
			'form',
			{ class: 'mt-4 flex flex-wrap items-end gap-2 rounded-lg bg-surface-2/60 p-3' },
			h('label', { class: 'field' }, h('span', { class: 'label' }, 'Key'), h('input', { name: 'key', required: true, pattern: '[A-Za-z0-9_.\\-]+', placeholder: 'e.g. email', class: 'input w-40', 'aria-label': 'field key', autocomplete: 'off' })),
			h('label', { class: 'field min-w-48 flex-1' }, h('span', { class: 'label' }, 'Value'), h('input', { name: 'value', required: true, placeholder: 'value', class: 'input w-full', 'aria-label': 'field value' })),
			h('label', { class: 'field' }, h('span', { class: 'label' }, 'Sensitivity'), sensitivitySelect(1)),
			h('button', { class: 'btn' }, 'Add field'),
		);
		add.addEventListener('submit', async (ev) => {
			ev.preventDefault();
			const v = formValues(add);
			try {
				status(note, 'Saving…');
				await api.personas.putField(persona.id, (v.key ?? '').trim(), { value: v.value ?? '', sensitivity: toSensitivity(v.sensitivity) });
				await load();
			} catch (e) {
				status(note, errorMessage(e), 'error');
			}
		});

		const remove = h(
			'button',
			{
				type: 'button',
				class: 'btn btn-sm btn-danger',
				onclick: async () => {
					const ok = await confirmDialog({
						title: `Delete persona “${persona.name}”?`,
						body: 'All its fields go with it. Rules that point at it will stop disclosing anything (they deny, they never fail open).',
						confirmLabel: 'Delete persona',
						danger: true,
					});
					if (!ok) return;
					try {
						await api.personas.remove(persona.id);
						await load();
					} catch (e) {
						status(note, errorMessage(e), 'error');
					}
				},
			},
			'Delete persona',
		);

		return h(
			'section',
			{ class: 'card', 'aria-labelledby': `persona-${persona.id}` },
			h(
				'header',
				{ class: 'mb-3 flex flex-wrap items-center justify-between gap-3' },
				h(
					'h2',
					{ id: `persona-${persona.id}`, class: 'flex items-center gap-2 text-base font-semibold' },
					persona.name,
					h('span', { class: 'pill pill-muted' }, `${persona.fields.length} field${persona.fields.length === 1 ? '' : 's'}`),
					tip('this persona', `id ${persona.id} — rules reference this id.`),
				),
				remove,
			),
			table,
			add,
			note,
		);
	}

	async function load(): Promise<void> {
		try {
			const personas = await api.personas.list();
			list.replaceChildren(
				...(personas.length
					? personas.map(personaCard)
					: [emptyState('No personas yet. Create your first one above — “work” or “legal” are good starts.')]),
			);
		} catch (e) {
			list.replaceChildren(h('p', { class: 'text-sm text-danger' }, `Could not load personas: ${errorMessage(e)}`));
		}
	}

	createForm.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const { name } = formValues(createForm);
		try {
			status(createStatus, 'Creating…');
			await api.personas.create({ name: (name ?? '').trim() });
			createForm.reset();
			status(createStatus, 'Created.', 'ok');
			await load();
		} catch (e) {
			status(createStatus, errorMessage(e), 'error');
		}
	});

	load();
</script>
